# Turso SQLite Cloud Database Configuration
# Get these values from your Turso Dashboard (https://turso.tech)

# The connection URL for your Turso Database
# Example: libsql://your-database-name-username.turso.io
# To use a local SQLite file for development, leave it blank or use "file:sitin.db"
TURSO_DATABASE_URL=file:sitin.db

# The secure access token for authentication
# Leave blank for local development
TURSO_AUTH_TOKEN=
